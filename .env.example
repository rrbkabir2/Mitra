# ==============================================================================
# MITRA DELIVERY CONFIRMATION PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your confidential keys.
# NEVER COMMIT .env.local TO GIT.
# ==============================================================================

# Application Base URL (used for generating vendor links and webhook callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key: used EXCLUSIVELY on backend API routes (webhook, token auth)
# NEVER expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Bucket for Delivery Photos
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=delivery-photos

# ------------------------------------------------------------------------------
# WHATSAPP BUSINESS PLATFORM (Cloud API by Meta)
# ------------------------------------------------------------------------------
# Required for production WhatsApp delivery confirmation messaging.
# Reference setup guide in README.md for Meta Business Verification steps.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_registered_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Webhook Security
# Used by Meta to verify the webhook URL challenge
WHATSAPP_WEBHOOK_VERIFY_TOKEN=create_a_strong_random_secret_token_here
# Meta App Secret used to verify x-hub-signature-256 HMAC of incoming webhook payloads
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------------
# SECURITY & ADMIN SEEDING
# ------------------------------------------------------------------------------
# Secret key used to authorize backend admin invite/seed scripts
ADMIN_SEED_SECRET=generate_a_secure_random_seed_secret_here
